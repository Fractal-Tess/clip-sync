#!/usr/bin/env bash
set -euo pipefail

if [[ -z "${WAYLAND_DISPLAY:-}" || -z "${XDG_RUNTIME_DIR:-}" ]]; then
  echo "WAYLAND_DISPLAY and XDG_RUNTIME_DIR must identify a live Wayland session" >&2
  exit 2
fi

if ! cargo fmt --version >/dev/null 2>&1; then
  if [[ -n "${CLIP_SYNC_LIVE_IN_NIX:-}" ]]; then
    echo "Rust tooling is unavailable inside the development shell" >&2
    exit 2
  fi
  exec env CLIP_SYNC_LIVE_IN_NIX=1 nix develop --command "$0" "$@"
fi

original_runtime=$XDG_RUNTIME_DIR
wayland_socket=$original_runtime/$WAYLAND_DISPLAY
if [[ ! -S "$wayland_socket" ]]; then
  echo "Wayland socket does not exist: $wayland_socket" >&2
  exit 2
fi

root=$(mktemp -d -t clip-sync-wayland.XXXXXX)
mkdir -p "$root/config/clip-sync" "$root/state" "$root/runtime"
ln -s "$wayland_socket" "$root/runtime/$WAYLAND_DISPLAY"
head -c 32 /dev/urandom >"$root/key"
chmod 0600 "$root/key"
cat >"$root/config/clip-sync/config.toml" <<EOF
[shared]
mesh_quota_bytes = 1073741824
capture_threshold_bytes = 20971520

[local]
mesh_key_file = "$root/key"
listen_port = 24892
discovery_interval_seconds = 3600
netbird_command = "netbird"
EOF

saved_clipboard=$root/original.txt
had_text=0
if timeout 3 wl-paste --no-newline --type text/plain >"$saved_clipboard" 2>/dev/null; then
  had_text=1
fi

daemon_pid=
source_pid=
cleanup() {
  if [[ -n "$source_pid" ]]; then
    kill "$source_pid" 2>/dev/null || true
    wait "$source_pid" 2>/dev/null || true
  fi
  if [[ -n "$daemon_pid" ]]; then
    kill "$daemon_pid" 2>/dev/null || true
    wait "$daemon_pid" 2>/dev/null || true
  fi
  if [[ $had_text -eq 1 ]]; then
    XDG_RUNTIME_DIR=$original_runtime wl-copy --type text/plain <"$saved_clipboard" || true
  else
    XDG_RUNTIME_DIR=$original_runtime wl-copy --clear 2>/dev/null || true
  fi
  rm -rf "$root"
}
trap cleanup EXIT INT TERM

cargo build --quiet
export XDG_RUNTIME_DIR=$root/runtime
export XDG_STATE_HOME=$root/state
export XDG_CONFIG_HOME=$root/config
export RUST_LOG=clip_sync=debug

target/debug/clip-sync daemon >"$root/daemon.log" 2>&1 &
daemon_pid=$!
for _ in $(seq 1 100); do
  [[ -S "$root/runtime/clip-sync/daemon.sock" ]] && break
  kill -0 "$daemon_pid" 2>/dev/null || {
    cat "$root/daemon.log" >&2
    exit 1
  }
  sleep 0.05
done
[[ -S "$root/runtime/clip-sync/daemon.sock" ]] || {
  echo "daemon socket did not appear" >&2
  cat "$root/daemon.log" >&2
  exit 1
}
for _ in $(seq 1 100); do
  if target/debug/clip-sync doctor --json 2>/dev/null | python3 -c '
import json, sys
checks = json.load(sys.stdin).get("checks", [])
raise SystemExit(not any(c.get("name") == "clipboard" and c.get("ok") for c in checks))
' 2>/dev/null; then
    break
  fi
  sleep 0.05
done
if ! target/debug/clip-sync doctor --json 2>/dev/null | python3 -c '
import json, sys
checks = json.load(sys.stdin).get("checks", [])
raise SystemExit(not any(c.get("name") == "clipboard" and c.get("ok") for c in checks))
' 2>/dev/null; then
  echo "Wayland clipboard watcher did not become ready" >&2
  cat "$root/daemon.log" >&2
  exit 1
fi

marker="clip-sync-live-$(date +%s%N)"
printf %s "$marker" | wl-copy --foreground --type text/plain &
source_pid=$!

history='[]'
for _ in $(seq 1 100); do
  history=$(target/debug/clip-sync history list "$marker" --json)
  [[ "$history" != '[]' ]] && break
  sleep 0.05
done
if [[ "$history" == '[]' ]]; then
  echo "daemon did not capture the live clipboard marker" >&2
  cat "$root/daemon.log" >&2
  exit 1
fi
content_id=$(printf %s "$history" | python3 -c \
  'import json,sys; items=json.load(sys.stdin); assert len(items)==1, items; print(items[0]["content_id"])')

kill "$source_pid"
wait "$source_pid" 2>/dev/null || true
source_pid=

target/debug/clip-sync history activate "$content_id" --json >/dev/null
actual=$(timeout 3 wl-paste --no-newline --type text/plain)
if [[ "$actual" != "$marker" ]]; then
  echo "activated clipboard differs from captured source" >&2
  exit 1
fi

mode=$(stat -c %a "$root/state/clip-sync/history.db")
if [[ "$mode" != 600 ]]; then
  echo "encrypted database mode is $mode, expected 600" >&2
  exit 1
fi

if grep -aFq "$marker" "$root/state/clip-sync/history.db"; then
  echo "plaintext marker was found in encrypted database" >&2
  exit 1
fi

printf 'live Wayland capture/source-exit/activation passed (%s)\n' "$content_id"
